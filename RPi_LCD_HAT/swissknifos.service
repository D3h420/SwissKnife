[Unit]
Description=SwissKnifOS LCD interface

[Service]
Type=simple
User=root
WorkingDirectory=/opt/SwissKnife
ExecStart=/usr/bin/python3 /opt/SwissKnife/RPi_LCD_HAT/app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=SWISSKNIFE_DATA_DIR=/var/lib/swissknife

[Install]
WantedBy=multi-user.target
