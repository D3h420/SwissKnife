#!/bin/sh
set -e
# Framebuffer, keyboard, and USB GPS access remain with the normal login user.
app_user=${SUDO_USER:-pi}
if [ "$app_user" != root ] && id -u "$app_user" >/dev/null 2>&1; then
    for group in video input dialout plugdev; do
        if getent group "$group" >/dev/null 2>&1; then
            usermod -aG "$group" "$app_user"
        fi
    done
fi
exit 0
